{
    "name": "jw-datatable-dev",
    "private": true,
    "type": "module",
    "description": "Dev tooling only (lint, type check, axe-core in the browser tests). The sources need no build or install.",
    "scripts": {
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
        "test": "node tests/run.js",
        "coverage": "node tests/run.js --coverage --coverage-min 99",
        "check": "npm run lint && npm run typecheck && npm run coverage"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.5",
        "axe-core": "4.14.0",
        "eslint": "10.12.0",
        "globals": "17.13.0",
        "typescript": "7.0.2"
    }
}
