{
    "branches": ["main"],
    "tagFormat": "v${version}",
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "node tools/build.js ${nextRelease.version} && node tests/run.js --browser --dist"
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": ["dist/jw-datatable.min.js"],
                "message": "chore(release): ${nextRelease.version} [skip ci]"
            }
        ],
        [
            "@semantic-release/github",
            {
                "assets": [{ "path": "dist/jw-datatable.min.js", "label": "jw-datatable.min.js" }]
            }
        ]
    ]
}
